# Copy to .env.local. Never commit real credentials.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional video generation via Replicate.
# Choose a model whose input schema accepts a "prompt" field.
# The configured value must use owner/model format.
REPLICATE_API_TOKEN=
REPLICATE_VIDEO_MODEL=

# Optional Supabase account and cloud-memory sync.
# Configure the Supabase project, apply the migration, and set auth redirect URLs.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only; current client-side account/memory features do not use this key.
# Never prefix this variable with NEXT_PUBLIC_ or expose it in browser code.
SUPABASE_SERVICE_ROLE_KEY=
