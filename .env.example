# Copy to .env.local. Never commit real credentials.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional video generation via Replicate; set both values to enable it.
REPLICATE_API_TOKEN=
REPLICATE_VIDEO_MODEL=

# Optional Supabase account/cloud-memory foundation (not enabled until configured)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
